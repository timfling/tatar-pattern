# Template: owner copies and edits paths/user on the Selectel VM after GPU smoke.
[Unit]
Description=Tatar Pattern SDXL inference on Selectel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=REPLACE_WITH_GPU_VM_USER
WorkingDirectory=/srv/tatar-lora-kit
EnvironmentFile=/etc/tatar-inference.env
Environment=HF_HOME=/srv/tatar-lora-kit/selectel/model-cache
Environment=HF_HUB_OFFLINE=1
Environment=HF_HUB_DISABLE_TELEMETRY=1
ExecStart=/srv/tatar-lora-kit/.venv/bin/python /srv/tatar-lora-kit/service/server.py --config /srv/tatar-lora-kit/service/config.json --state /srv/tatar-lora-kit/service/state --port 8765
Restart=on-failure
RestartSec=10
KillMode=control-group
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
