{
  admin off
  auto_https off
}
:8081 {
  bind 127.0.0.1
  respond /healthz 200
}
:80 {
  request_body {
    max_size 1MB
  }
  @private path /docs /docs/* /redoc /openapi.json /api/docs /api/openapi.json
  respond @private 404
  handle /api/* {
    reverse_proxy backend:8000 {
      header_up X-Forwarded-For {remote_host}
      header_up X-Forwarded-Proto {scheme}
    }
  }
  handle {
    reverse_proxy frontend:3000
  }
}
