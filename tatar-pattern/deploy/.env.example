# Fill via ops.py init; production secrets never in Git, screenshots or summary.
COMPOSE_PROJECT_NAME=tp-production
RELEASE=pilot-20261011-2
DOMAIN=replace.example
ACME_EMAIL=replace@example.invalid
DATA_ROOT=/srv/tatar-pattern/data
# Exactly 64 random lowercase hex characters: no URL escaping/interpolation risks.
POSTGRES_PASSWORD=REPLACE_WITH_64_HEX
POSTGRES_IMAGE=tatar-pattern-postgres:pilot-20261011-2
CADDY_IMAGE=tatar-pattern-caddy:pilot-20261011-2

# AI services are opt-in (--profile ai); AI_MVP_ENABLED stays false in Compose.
# These are paths/nonsecret settings; do not put keys or Bearer values here.
AI_PROVIDER_ENV_FILE=/etc/tatar-pattern/ai-provider.env
GPU_SSH_KEY_FILE=/etc/tatar-pattern/gpu/id_ed25519
GPU_KNOWN_HOSTS_FILE=/etc/tatar-pattern/gpu/known_hosts
GPU_SSH_HOST=NOT_CONFIGURED.invalid
GPU_SSH_PORT=22
GPU_SSH_USER=tunnel
# Agreed target GPU listener; not a verified running endpoint:
GPU_API_PORT=8765
GPU_BEARER_FILE=/etc/tatar-pattern/gpu/bearer
# Backend + deploy checks; versions are configuration, not proof of readiness.
AI_GPU_BASE_URL=http://gpu-tunnel:18765
AI_GPU_TOKEN_FILE=/run/secrets/gpu_bearer
AI_GPU_HTTP_PROOF_FILE=/data/storage/ai-gpu-worker-proof.json
GPU_EXPECTED_WORKFLOW_VERSION=tp-sdxl-composition-img2img/1.0.0
GPU_EXPECTED_MODEL_VERSION=378c08ff157660a3399573e1cd5918ad8f3aec344646c5336b027d63fe50ca42
