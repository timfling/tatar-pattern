# Fill with your own local credentials; do not commit .env.
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@127.0.0.1:5432/tatar_pattern
STORAGE_ROOT=./storage
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false
ALLOW_FIXTURES=false
SESSION_DAYS=7

# AI remains unavailable until profiles/material transfer and real GPU HTTP are verified.
AI_MVP_ENABLED=false
# Private tunnel only; no public GPU port. Missing proof keeps provider.ready=false.
# AI_GPU_BASE_URL=http://gpu-tunnel:18765
# Exactly one credential source; do not set both (or commit a real token).
# AI_GPU_TOKEN_FILE=/run/secrets/gpu_bearer
# AI_GPU_TOKEN=<server-only token, minimum 32 ASCII characters>
# GPU_EXPECTED_WORKFLOW_VERSION=tp-sdxl-composition-img2img/1.0.0
# GPU_EXPECTED_MODEL_VERSION=378c08ff157660a3399573e1cd5918ad8f3aec344646c5336b027d63fe50ca42
# Written only by the owner-run probe in deployed worker namespace, shared readonly with API.
# AI_GPU_HTTP_PROOF_FILE=/data/storage/ai-gpu-worker-proof.json
