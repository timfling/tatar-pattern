# Публикуются только исходники сайта и ИИ.
/*
!/.gitignore
!/README.md
!/GITHUB.md
!/tatar-pattern/
!/ИИ/

# Локальные настройки, секреты, зависимости и результаты
**/.git/
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.log
.DS_Store
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
node_modules/
.next/
dist/
build/
coverage/
*.tsbuildinfo
storage/
local-test/
local-check/
backups/
*.zip
*.tar
*.tar.gz
*.sqlite*
*.dump

# Рабочие данные, дизайн, отчёты и артефакты сайта
/tatar-pattern/.figma-cache/
/tatar-pattern/design/
/tatar-pattern/backend/catalog-input/
/tatar-pattern/backend/docs/
/tatar-pattern/frontend/qa/*
!/tatar-pattern/frontend/qa/*.py
!/tatar-pattern/frontend/qa/*.mjs
!/tatar-pattern/frontend/qa/security-2026-10-11/
/tatar-pattern/frontend/qa/security-2026-10-11/*
!/tatar-pattern/frontend/qa/security-2026-10-11/*.mjs
/tatar-pattern/frontend/.qa/
/tatar-pattern/frontend/CLAUDE.md
/tatar-pattern/deploy/images/
/tatar-pattern/deploy/release-evidence/
/tatar-pattern/deploy/*.json
/tatar-pattern/deploy/*CHECK*.md
/tatar-pattern/deploy/VERIFICATION.md
/tatar-pattern/deploy/HANDOFF.md
/tatar-pattern/deploy/FRONTEND-COMPATIBILITY*.md
/tatar-pattern/deploy/BEGET.md
/tatar-pattern/DEPLOY-PACK.md

# Только код ИИ: материалы владельца, исследования и датасет не публикуются
/ИИ/*
!/ИИ/service/
!/ИИ/pilot/
!/ИИ/scripts/
!/ИИ/selectel/
/ИИ/service/*.json
!/ИИ/service/config.example.json
/ИИ/pilot/*.json
/ИИ/pilot/*.csv
/ИИ/selectel/*.json

/tatar-pattern/tools/dataset/ПРОМПТ*.md
